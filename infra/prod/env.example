# /opt/fallrush/.env (root, chmod 600). Placeholders only in git.
P2_NET=devnet
GAME_AUTHORITY_KEYPAIR=/secrets/game-authority.json
FUNDER_KEYPAIR=/secrets/funder.json
ACTION=1
MM=1
KEEPERS=gs1=http://fallrush-keeper-1:3111,gs2=http://fallrush-keeper-2:3111
GS_PUBLIC=gs1=wss://gs1.<VPS_IP-dashed>.sslip.io,gs2=wss://gs2.<VPS_IP-dashed>.sslip.io,gs3=wss://gs1.<VPS_IP-dashed>.sslip.io/gs3
SOLANA_RPC_URL=https://api.devnet.solana.com
ER_RPC_URL=https://devnet-as.magicblock.app
# P6: sealed Champion bets (MagicBlock Private ER) + seasons (defaults on); an active test season id (≥ 1000000) or 0
SEALED=1
SEASONS=1
TEE_URL=https://devnet-tee.magicblock.app
TEST_SEASON=0
# submission: judge mode (POST /api/judge, /play?judge=1); on by default when rooms are on, JUDGE_ON=0 turns it off
JUDGE_ON=1
JUDGE_PER_IP_HOUR=4
# --- harden (2026-11-25): keeper + indexer knobs. Every value below is the code default; leave a line commented out
# --- (or delete it) to keep the default. Lamports: 1 SOL = 1,000,000,000.
# Boot-time treasury floor (econ setupEcon): the treasury PDA is funded up to this when it holds less than half of it.
#TREASURY_LAMPORTS=60000000
# Before a finalize that mints (Crown / capsules), top the treasury up to this when it cannot cover what the match owes.
# Keep it above LOW_TREASURY_LAMPORTS, or the treasury reads "low" right after every top-up.
#TREASURY_TOPUP_LAMPORTS=150000000
# Low-balance flags in /status and /api/health (keeper + indexer) and a log line when a wallet turns low. No transfers.
#LOW_AUTHORITY_LAMPORTS=300000000
#LOW_TREASURY_LAMPORTS=100000000
#LOW_FUNDER_LAMPORTS=200000000
# The guest gas funder's PUBLIC key, so the keepers can watch its balance (its keypair stays in the indexer only).
#FUNDER_PUBKEY=<funder pubkey, base58>
# Record finalized matches into the Seasons. The keeper pauses them by itself at the MagicBlock 10-commit cap; 0 = off.
SEASONS=1
# Stall recovery: hybrid-mode tick() drive time after a stall, ms (full mode only re-schedules the tasks).
#DRIVE_MS=6000
# Full mode: replace the timed tasks every ROTATE_MS (on MagicBlock core 2.0.4 failed executions are retried, so
# this is churn, not a need; kept as is until measured).
#ROTATE_MS=8000
# Full mode: the Classic server stopped playing this on-chain match for this long → abort + refund (reason 8).
#ORPHAN_MS=10000
# Full mode: 1 = the keeper crank sends only while the World is behind real time or stalled (saves ~45 no-op tx/s in
# R2–R4). Turn on only after `tools/fullchain/load.ts compare` says ship (scripts/fc-load.sh, dev arena 7). 0 = always send.
CRANK_GATE=0
# Fine tuning (only with CRANK_GATE=1): open above this tick debt / after this long without World progress; close at
# or below CRANK_CLOSE_TICKS after at least CRANK_GATE_HOLD_MS open.
#CRANK_LAG_TICKS=3
#CRANK_CLOSE_TICKS=1
#CRANK_GATE_STALL_MS=50
#CRANK_GATE_HOLD_MS=500
# Dev arenas only (load tests): start_sim waits (≤ FULL_WAIT_HUMANS_S) for this many on-chain joins. Keep 0 in
# production: a higher value delays every full match that has fewer humans by FULL_WAIT_HUMANS_S.
FULL_MIN_HUMANS=0
#FULL_WAIT_HUMANS_S=20
