# /opt/fallrush/.env (root, chmod 600). Placeholders only in git.
P2_NET=devnet
GAME_AUTHORITY_KEYPAIR=/secrets/game-authority.json
FUNDER_KEYPAIR=/secrets/funder.json
ACTION=1
MM=1
KEEPERS=gs1=http://fallrush-keeper-1:3111,gs2=http://fallrush-keeper-2:3111
GS_PUBLIC=gs1=wss://gs1.<VPS_IP-dashed>.sslip.io,gs2=wss://gs2.<VPS_IP-dashed>.sslip.io,gs3=wss://gs1.<VPS_IP-dashed>.sslip.io/gs3
SOLANA_RPC_URL=https://api.devnet.solana.com
ER_RPC_URL=https://devnet-as.magicblock.app
# P6: sealed Champion bets (MagicBlock Private ER) + seasons (defaults on); an active test season id (≥ 1000000) or 0
SEALED=1
SEASONS=1
TEE_URL=https://devnet-tee.magicblock.app
TEST_SEASON=0
# submission: judge mode (POST /api/judge, /play?judge=1); on by default when rooms are on, JUDGE_ON=0 turns it off
JUDGE_ON=1
JUDGE_PER_IP_HOUR=4
