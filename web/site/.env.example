# Public URL of the site (no trailing slash). Used for share links / poster text / og tags.
VITE_SITE_URL=https://your-site.com
# Base URL of the waitlist worker API. Empty = same origin (the worker's routes /api/*, /r/*, /p/* sit on the site's domain).
VITE_API_BASE=
# Dev only: where `npm run dev` proxies /api, /r, /p (wrangler dev).
WORKER_DEV_URL=http://localhost:8787
# Cloudflare Turnstile site key (public). Empty = no bot check.
VITE_TURNSTILE_SITE_KEY=
